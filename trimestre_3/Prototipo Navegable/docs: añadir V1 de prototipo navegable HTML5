    <!-- =========================================================================================
         LA ZONA DEL JAVASCRIPT (EL MOTORCITO QUE HACE LA MAGIA VIVA)
         ========================================================================================= -->
    <script> /* Abrimos etiqueta de script pa' meter código Javascript */

        /* 
           FUNCION 1: CAMBIAR PANTALLAS
           Esta la hicimos antes. Recibe un nombre (id) y apaga todo para prender solo ese.
        */
        function cambiarPantalla(idPantallaDestino) { /* Declaramos la función que pide como parámetro el id de la pantalla a mostrar */
            let todasLasPantallas = document.querySelectorAll('.pantalla'); /* Atrapamos en una lista a todas las etiquetas HTML que tengan la clase "pantalla" */
            
            todasLasPantallas.forEach(function(pantalla) { /* Hacemos un bucle: cogemos una por una todas las pantallas encontradas... */
                pantalla.classList.remove('activa'); /* ...y les arrancamos la clase "activa" para que el CSS de arriba las esconda. */
            }); /* Fin del bucle que esconde todo */
            
            let pantallaDestino = document.getElementById(idPantallaDestino); /* Buscamos específicamente la pantalla a la que queremos ir (usando el ID que le mandamos) */
            pantallaDestino.classList.add('activa'); /* Le ponemos la clase "activa" SOLAMENTE a esa pantalla para que el CSS la muestre. */
        } /* Fin de la función de cambiar pantallas */


        /* 
           FUNCION 2 (NUEVA): AUTOCOMPLETAR EL LOGIN
           Esta función es la que pediste: cuando le das clic a la cuenta demo, 
           agarra el correo y la contraseña que le mandamos por HTML y las zampa en las cajas de texto de arriba.
           Le pedimos 4 cosas: el email, el password, y cómo se llaman las cajitas donde los va a meter (idCajitaEmail, idCajitaClave)
        */
        function llenarDatos(email, password, idCajitaEmail, idCajitaClave) { /* Creamos la función con sus 4 parámetros pa' saber qué meter y en dónde */
            
            let cajitaEmail = document.getElementById(idCajitaEmail); /* Buscamos en el HTML la cajita de texto donde va el correo (ej. "correo-general") */
            cajitaEmail.value = email; /* A esa cajita le decimos que su "valor" (lo que tiene escrito adentro) va a ser el correo que le mandamos por parámetro */
            
            let cajitaClave = document.getElementById(idCajitaClave); /* Buscamos en el HTML la cajita de texto donde va la contraseña (ej. "clave-general") */
            cajitaClave.value = password; /* Le zampamos la contraseña directamente a esa cajita de texto */
            
            /* (Opcional, pero se ve fino): Como el usuario ya le dio clic al demo, le ponemos el cursor en el botón de INICIAR SESIÓN o que brille un poquito, 
               pero por ahora con solo llenarle las cajas ya cumple perfecto con lo que pediste! */
            
        } /* Fin de la función de llenar datos */

    </script> <!-- Cerramos la etiqueta de Javascript -->

